{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "comicbookstores",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "comicbookstores" }],
  // Contact form messages (table contact_submissions, see migrations/).
  "d1_databases": [{ "binding": "DB", "database_name": "comicbookstores", "database_id": "bbfc3909-bac0-4c14-b800-bc4d2ee9f784" }],
  "routes": [
    { "pattern": "comicbookstores.co", "custom_domain": true },
    { "pattern": "www.comicbookstores.co", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true }
}
